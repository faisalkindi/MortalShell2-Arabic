<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Mortal Shell II Arabic Installer</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Mortal Shell II Arabic Localization</Product>
    <Authors>Kindiboy</Authors>
    <Company>Kindiboy</Company>
    <Copyright>© Kindiboy</Copyright>
    <AssemblyTitle>تعريب Mortal Shell II — by Kindiboy</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip"><LogicalName>payload.zip</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ui\ui_logo.png"><LogicalName>ui_logo.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ui\ui_font.ttf"><LogicalName>ui_font.ttf</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ui\ui_bg.jpg"><LogicalName>ui_bg.jpg</LogicalName></EmbeddedResource>
  </ItemGroup>
</Project>
