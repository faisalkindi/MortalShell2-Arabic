 {
  "key": "Dialogue_Dlg_Gorf_Interact_01/2763381C4FCAB1019B27BDB1954EC900",
  "file": "batch_130.json",
  "speaker": "",
  "source_en": "I’m Gorf, by the way. (burp)",
