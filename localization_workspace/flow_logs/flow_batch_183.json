 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_GiveWater/2A438B9E447793E51A5147BCC5578A79",
  "before": "أنا... لا.",
  "after": "أنا... لستُ أفضّله.",
  "why": "bare 'لا' is not an answer in Arabic; the verb of the question must be repeated"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_GiveWater/E41A44E04BC3393E8E7DFC8833AC54B5",
  "before": "لماذا تُفضّله؟ عليّ.",
  "after": "لِمَ تؤثره؟ عليّ أنا.",
  "why": "the trailing 'عليّ' fragment needs أنا to land as it does in English"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_GiveWine/D06124D1458026B879E72DADEB37DEFD",
  "before": "حفظتُ أسرارك بأمان، يا أبي.",
  "after": "حفظتُ أسرارك يا أبي.",
  "why": "'بأمان' is redundant after حفظ; also no comma before the vocative"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_Outro/238C2F07481CCC6B1584D1883E54B191",
  "before": "آه، لا تتظاهر بالسذاجة، يا أبي.",
  "after": "أوه، لا تتصنّع البراءة يا أبي.",
  "why": "coy is feigned innocence, not السذاجة (stupidity); vocative comma removed"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_Outro/0D7C841743B80FE29D2546B8CCF7185A",
  "before": "مهلًا... أهذا ما يدور حوله كل هذا؟",
  "after": "مهلًا... أهذا كل ما في الأمر؟",
  "why": "'ما يدور حوله كل هذا' is a word-for-word carry of 'what this is all about'"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_Outro/A6FD32E849BE17B7701FD7BB0A1D907A",
  "before": "كان يجب أن تأمر بقتلي!",
  "after": "كان عليك أن تأمر بقتلي!",
  "why": "matches the sibling line"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_Outro/814FFFA04EA243E393583E98E2808282",
  "before": "لقد قلتَ ما يكفي، يا إيغون.",
  "after": "كفاك كلامًا يا إيغون.",
  "why": "'قلتَ ما يكفي' is literal; كفاك كلامًا is the Arabic rebuke"
 },
 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_TakePiss/E251E4174BAA7D4CC489DC9A21B845D9",
  "before": "«هدية» قاسية... لكنها ليست بغير مستحقة.",
  "after": "«هدية» قاسية... لكنها ليست بلا استحقاق.",
