 {
  "key": "Dialogue_Dlg_ShellMemory_Lazlo_ThePrisoner_02_GivePiss/E8BB3C314CB2D755BCE3ABB3776D12D2",
  "before": "كان يجب أن تأمر بقتلي!",
  "after": "كان عليك أن تأمر بقتلي!",
